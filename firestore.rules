rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isValidBook() {
      let required_fields = [
        'cim',
        'szerzo',
        'ar',
        'isbn',
        'kiado'
      ];
      
      return required_fields.every(field => 
        request.resource.data[field] is string || 
        (field == 'ar' && request.resource.data[field] is number)
      ) &&
      request.resource.data.ar > 0 &&
      request.resource.data.keszlet is int &&
      request.resource.data.keszlet >= 0;
    }

    // Books collection
    match /konyv/{document=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidBook();
      allow delete: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Categories collection
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}